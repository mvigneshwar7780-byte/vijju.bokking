# ---------------------------------------------------------------------------
# Copy to backend/.env and adjust. Every value has a working default for local
# development, so an empty .env is a valid starting point.
# ---------------------------------------------------------------------------

# --- app ---
ENVIRONMENT=local
DEBUG=true

# --- database: local PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cineai
POSTGRES_PASSWORD=cineai_dev_pw
POSTGRES_DB=cineai
POSTGRES_SSLMODE=prefer
DB_ECHO=false

# --- database: a managed provider (Aiven / Neon / RDS) ---
# POSTGRES_HOST=pg-xxxxx.h.aivencloud.com
# POSTGRES_PORT=19798
# POSTGRES_USER=avnadmin
# POSTGRES_PASSWORD=...              # special characters are escaped for you
# POSTGRES_DB=defaultdb
# POSTGRES_SSLMODE=require           # or verify-full with the CA below
# POSTGRES_SSLROOTCERT=certs/aiven-ca.pem
#
# Keep pool_size + max_overflow well under the plan's connection limit; it is
# shared with migrations, psql and anything else you point at the database.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# --- auth ---
# Change both of these for anything that is not your laptop. Minimum 32 bytes.
JWT_SECRET=dev-only-secret-change-me-32-bytes-minimum-length
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
TICKET_QR_SECRET=dev-only-ticket-secret-change-me-32-bytes-min

# --- booking rules ---
SEAT_HOLD_TTL_SECONDS=480        # how long a seat selection is reserved
MAX_SEATS_PER_BOOKING=10
BOOKING_CUTOFF_MINUTES=20        # sales close N minutes before showtime
CANCELLATION_CUTOFF_MINUTES=120  # no refunds inside N minutes of showtime
CONVENIENCE_FEE_PERCENT=8.00
CONVENIENCE_FEE_CAP_MINOR=6000   # Rs 60.00, in paise

# --- payments ---
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_FAILURE_RATE=0.0    # raise to 0.2 to exercise the failure paths
MOCK_GATEWAY_LATENCY_MS=250
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# --- workers ---
ENABLE_SCHEDULER=true
HOLD_SWEEPER_INTERVAL_SECONDS=60
