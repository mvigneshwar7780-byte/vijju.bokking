ENVIRONMENT=local
DEBUG=true

POSTGRES_HOST=pg-368ac8e6-mudhireddynandu-664d.h.aivencloud.com
POSTGRES_PORT=19798
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=AVNS_g0BOSC8jDawaxrGWTfz
POSTGRES_DB=defaultdb

# Aiven terminates TLS and refuses plaintext. "require" encrypts but does not
# verify the server's identity. Once you download the CA certificate from the
# console (Connection information -> CA certificate -> download) into
# backend/certs/aiven-ca.pem, switch to verify-full and set the path below --
# that is what actually protects against a man-in-the-middle.
# verify-full: encrypt AND verify the server's certificate chain and hostname.
# "require" alone encrypts but authenticates nothing, so it does not stop a
# man-in-the-middle. The path is relative to the backend/ directory.
POSTGRES_sslmode=require
POSTGRES_SSLROOTCERT=certs/aiven-ca.pem

# The Aiven plan shown allows 20 connections in total, shared across every
# client. pool_size + max_overflow is this process's ceiling; the rest is
# headroom for migrations, psql and the scheduler.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- auth (change these for anything that is not your laptop) ---
JWT_SECRET=dev-only-secret-change-me-32-bytes-minimum-length
TICKET_QR_SECRET=dev-only-ticket-secret-change-me-32-bytes-min

# --- booking rules ---
SEAT_HOLD_TTL_SECONDS=480
MAX_SEATS_PER_BOOKING=10
BOOKING_CUTOFF_MINUTES=20
CANCELLATION_CUTOFF_MINUTES=120

# --- payments ---
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# --- workers ---
ENABLE_SCHEDULER=true
HOLD_SWEEPER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Tests never use the values above. `tests/conftest.py` forces a LOCAL database
# (cineai_test) because the suite truncates every table on each run, and
# because the seat-race tests would otherwise eat the shared connection budget.
# Override only with TEST_AGAINST_REMOTE=1, and only against a disposable DB.
# ---------------------------------------------------------------------------
